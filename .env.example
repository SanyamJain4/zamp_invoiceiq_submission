# ---------- AI extraction ----------
# auto      -> use the first provider that has a key; with no key falls back to the offline rule-based parser
# anthropic | openai | gemini -> force a provider (a missing key is reported as a clear error, never faked)
# heuristic -> always use the offline parser (deterministic; used by the automated tests)
LLM_PROVIDER=auto
LLM_MODEL=            # optional override, e.g. claude-sonnet-5-5 / gpt-4o-mini / gemini-2.0-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY= 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
GEMINI_API_KEY= AQ.Ab8RN6Jt-Ujre_-ivk24paC_fBNd51-SExyWZC0mUiFfd_rNhw
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# ---------- Storage ----------
# SQLite by default; the schema is portable to PostgreSQL, e.g. postgresql+psycopg://user:pass@db:5432/invoiceiq
DATABASE_URL=sqlite:///./backend/data/invoiceiq.db
UPLOAD_DIR=./backend/data/uploads
MAX_UPLOAD_MB=15
MAX_PAGES=30

# ---------- Financial policy (see docs/BUSINESS_RULES.md) ----------
TOLERANCE_PCT=1.0        # % price/total variance accepted
TOLERANCE_ABS=0.00       # optional fixed monetary tolerance (0 = off)
ROUNDING_TOLERANCE=0.05  # arithmetic rounding allowance
MAX_INVOICE_AGE_DAYS=365

# ---------- Our company (the buyer; never mistaken for the vendor) ----------
BUYER_NAME=Northwind Industries Pvt Ltd
BUYER_TAX_ID=29AABCN1234F1Z5

# ---------- Web ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
